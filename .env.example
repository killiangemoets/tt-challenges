# Copy to .env and paste the scoped, spend-capped key we send you
# (reply to your invite email to get one). This is the only external
# dependency — everything else runs locally in Docker.
ANTHROPIC_API_KEY=

# Host ports exposed by Docker Compose
FRONTEND_PORT=5173
API_PORT=3000

# Local defaults. Compose overrides service hosts with db/minio/queue.
DATABASE_URL=postgresql://brain:brain@localhost:5432/secondbrain
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio-root
MINIO_SECRET_KEY=minio-secret
MINIO_BUCKET=second-brain
SQS_ENDPOINT=http://localhost:9324
SQS_QUEUE_NAME=ingest
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
APP_ALLOWED_ORIGINS=["http://localhost:5173"]
VITE_API_URL=http://localhost:3000
