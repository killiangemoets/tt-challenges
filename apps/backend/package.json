{
  "name": "@second-brain/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev:api": "prisma migrate deploy && prisma generate && tsx watch src/api/server.ts",
    "dev:worker": "prisma migrate deploy && prisma generate && tsx watch src/worker/main.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "start:api": "prisma migrate deploy && node dist/api/server.js",
    "start:worker": "prisma migrate deploy && node dist/worker/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/client-sqs": "latest",
    "@fastify/cors": "latest",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "latest",
    "@fastify/swagger-ui": "latest",
    "@prisma/client": "^6.19.1",
    "@xenova/transformers": "latest",
    "axios": "latest",
    "fastify": "latest",
    "pino": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "prisma": "^6.19.1",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
